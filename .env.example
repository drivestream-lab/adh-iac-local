# ADH local infra — copy to .env (gitignored). Do not commit secrets.
# Postgres user/password defaults match docker-compose.local-infra.yml.

POSTGRES_USER=adh
POSTGRES_PASSWORD=adh
POSTGRES_DB=adh

# LiteLLM Admin UI + OpenAI-compatible API — http://localhost:4000
# UI-first: add OpenRouter key + models in http://localhost:4000/ui (not here).
LITELLM_MASTER_KEY=sk-adh-local-master
LITELLM_SALT_KEY=adh-local-salt-change-me
LITELLM_POSTGRES_DB=litellm
UI_USERNAME=adh-admin
UI_PASSWORD=adh-admin
# OpenRouter — required to call glm / qwen / kimi-k3. Never commit the value.
OPENROUTER_API_KEY=
